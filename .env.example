# Copy this file to .env.local and fill in your key.
# Get a free key at https://aistudio.google.com/app/apikey
#
# When set, visitors can use the AI Mentor without their own key.
# When empty, each visitor pastes their own key in the AI Mentor tab.
GEMINI_API_KEY=

# Optional: Gemini model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
